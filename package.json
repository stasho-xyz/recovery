{
  "name": "@stasho-app/recovery",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Standalone Stasho recovery script. Reconstructs project + deployment history from a wallet's signed on-chain messages without depending on the backend.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "recover": "tsx src/main.ts"
  },
  "dependencies": {
    "eciesjs": "0.4.18",
    "ethers": "6.16.0",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "5.9.3",
    "vitest": "4.1.3"
  }
}
